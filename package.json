{
  "name": "fik-jou3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Morocco-first marketplace for homemade food.",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "tsx scripts/run-playwright.ts",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "deps:check": "npm ci --ignore-scripts --dry-run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:migrate:check": "vitest run --config vitest.integration.config.ts tests/integration/migration-replay.test.ts",
    "db:seed:check": "vitest run --config vitest.integration.config.ts tests/integration/phase-01-foundation.test.ts -t \"seeds complete\"",
    "i18n:check": "tsx scripts/verify-messages.ts",
    "quality": "npm run deps:check && npm run format:check && npm run lint && npm run typecheck && npm run i18n:check && npm run test && npm run test:integration && npm run db:migrate:check && npm run db:seed:check && npm run test:e2e && npm run build && npm audit --audit-level=critical"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.6",
    "better-auth": "1.7.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "geist": "1.7.2",
    "lucide-react": "1.49.0",
    "next": "16.3.7",
    "next-intl": "4.14.8",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "pg-embedded": "0.2.3",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
