# Public values are embedded in browser bundles. Never place secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_APP_NAME="Fik Jou3?"

# Server-only absolute application origin. Production must set its deployed HTTPS URL.
APP_URL="http://localhost:3000"

# Required at application runtime. Use a least-privilege PostgreSQL role outside local development.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# At least 32 random bytes. Never expose this value through NEXT_PUBLIC_*.
BETTER_AUTH_SECRET="replace-with-at-least-32-random-bytes"

# Development writes verification/reset messages to the ignored local outbox. Production
# deliberately rejects this mode until a provider adapter is selected and configured.
EMAIL_DELIVERY_MODE="development"
DEV_EMAIL_OUTBOX_DIR=".tmp/email-outbox"

# Only trust proxy headers from the configured deployment platform. The default direct
# connection address is used locally; Phase 11 must verify the production proxy contract.
AUTH_TRUSTED_IP_HEADER="x-forwarded-for"

# Development-only visual fixture mode for the public marketplace shell.
# Production rejects "populated" and always renders truthful database state.
FIK_MARKETPLACE_PREVIEW="populated"

# Optional external PostgreSQL target for integration tests. When absent, the Phase 00
# harness starts a disposable local PostgreSQL instance from the pinned dev dependency.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/TEST_DATABASE"
