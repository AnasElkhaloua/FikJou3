# Public values are embedded in browser bundles. Never place secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_APP_NAME="Fik Jou3?"

# Server-only absolute application origin. Production must set its deployed HTTPS URL.
APP_URL="http://localhost:3000"

# Phase 01 will require DATABASE_URL. Phase 00 does not connect the application to a database.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional external PostgreSQL target for integration tests. When absent, the Phase 00
# harness starts a disposable local PostgreSQL instance from the pinned dev dependency.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/TEST_DATABASE"
